# Copy this file to `.env` and fill in your Supabase project credentials.
# Find these in your Supabase dashboard: Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# ── Google / Apple native sign-in ──────────────────────────────────────────────
# See docs/google-apple-sign-in.md for exactly where each of these comes from.
GOOGLE_WEB_CLIENT_ID=your-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-id.apps.googleusercontent.com
APPLE_SERVICE_ID=com.yourcompany.rootsphere.signin

# ── Server-side secrets (NEVER placed here / on the client) ───────────────────
# Phase 4 AI hints are powered by Claude in the `hints` Edge Function. Set the
# API key as a Supabase secret, not in this file:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   (optional) supabase secrets set CLAUDE_MODEL=claude-sonnet-4-6
# When unset, the app degrades gracefully to local heuristic hints.
